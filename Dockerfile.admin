# syntax=docker/dockerfile:1.7
# Admin portal: builds the React UI, then serves it from the Node API.

FROM node:22-bookworm-slim AS ui
WORKDIR /ui
COPY admin/package.json admin/package-lock.json ./
RUN npm ci
COPY admin/ ./
RUN npm run build

# Modern Docker CLI (Debian docker.io is too old for current Docker Desktop API).
FROM docker:27-cli AS dockercli

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY vendor ./vendor
COPY server ./server
COPY src ./src
COPY --from=ui /ui/dist ./admin/dist
COPY docker-compose.yml Dockerfile ./

ENV NODE_ENV=production
ENV PORT=8787

EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8787/api/health || exit 1

CMD ["node", "server/index.js"]
