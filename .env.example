# Copy to .env and replace every placeholder before deploy:
#   cp .env.example .env
#
# Generate secrets:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 28   # ADMIN_PASSWORD
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40   # POSTGRES_PASSWORD
#   openssl rand -hex 32                                       # SESSION + BOT tokens

NODE_ENV=production
# Server clock + Node timezone (shown in admin nav as "Server")
TZ=Asia/Kolkata

# --- Postgres ---
POSTGRES_USER=matik
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=matik
POSTGRES_PORT=55432

# Host / local admin process (use 127.0.0.1)
DATABASE_URL=postgres://matik:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:55432/matik
# Docker Compose overrides DATABASE_URL to reach service "db" automatically.

# --- Admin portal ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_16PLUS
ADMIN_SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL
ADMIN_BOT_TOKEN=REPLACE_WITH_64_CHAR_HEX_FROM_OPENSSL

# true when serving over HTTPS
ADMIN_COOKIE_SECURE=false

# Bot containers call the admin API at this URL (not the browser URL).
# On a Linux VM with Docker, host-gateway usually maps this correctly:
ADMIN_PUBLIC_URL=http://host.docker.internal:8787

PORT=8787

# --- SMTP (success emails; secrets only in .env, never in source/UI) ---
SMTP_ENABLED=0
SMTP_HOST=smtp.iitd.ac.in
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=